# Copie este arquivo para .env e preencha com os seus dados.
# O .env fica fora do git (está no .gitignore).

# Conexão com o MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/

# Nome do banco (opcional). Sem ele, usa "zeon".
# MONGODB_DB=zeon

# Token do Vercel Blob, para guardar as fotos (Vercel > Storage > seu Blob Store)
BLOB_READ_WRITE_TOKEN=
